# Copy to .env and fill in. Never commit .env.
# Load it before starting the server:  set -a && source .env && set +a

# Required: Claude API key (news triage + research agent)
ANTHROPIC_API_KEY=

# Optional: macro data sources (features are skipped when empty)
FRED_API_KEY=
EIA_API_KEY=

# Optional: shared secret for POST /api/x-digest (sent as the x-mp-key header)
MP_INGEST_KEY=

# Optional: Telegram reports (also disabled by TELEGRAM_ENABLED in config.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: SQLite file location. Leave commented to use the default;
# an empty value would override it.
# MP_DB_PATH=market_pulse.db
